# ==============================================================================
# Hospital Management Platform - Environment Variables Template
# Copy this file to .env before starting the services locally.
# DO NOT COMMIT REAL CREDENTIALS TO SOURCE CONTROL.
# ==============================================================================

# Application Port and Environment
NODE_ENV=production
PORT=3000

# Security and JWT Authentication
# Replace with a strong, random 32+ character secret string in production
JWT_SECRET=replace_with_a_secure_random_jwt_secret_key_at_least_32_chars
JWT_EXPIRES_IN=24h

# MongoDB Credentials (Used by Docker Compose / App)
MONGO_ROOT_USERNAME=rootadmin
MONGO_ROOT_PASSWORD=replace_with_strong_root_password
MONGO_APP_USERNAME=hospital_app
MONGO_APP_PASSWORD=replace_with_strong_app_password
MONGO_DATABASE=hospital_db
MONGO_HOST=mongo
MONGO_PORT=27017

# Database Connection URI (Used by Express application)
# For local docker-compose: mongodb://hospital_app:<password>@mongo:27017/hospital_db?authSource=hospital_db
MONGO_URI=mongodb://hospital_app:replace_with_strong_app_password@mongo:27017/hospital_db?authSource=hospital_db

# Logging & Monitoring
LOG_LEVEL=info
ENABLE_METRICS=true
