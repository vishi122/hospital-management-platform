# Dependencies
node_modules/
.pnp
.pnp.js

# Environment and Secrets (CRITICAL: Never commit secrets)
.env
.env.local
.env.*.local
*.pem
*.key
*.crt
*.csr

# SSL Certificates
nginx/certs/*.crt
nginx/certs/*.key
nginx/certs/*.pem
!nginx/certs/.gitkeep

# Backups (Keep directory via .gitkeep)
backups/*
!backups/.gitkeep

# Testing and Coverage
coverage/
.nyc_output/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Docker local data overrides
.docker/

# OS and Editor files
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
